    {"role": "cameraObservation", "family": "cyanWhiteLowState", "nonColorCarrier": "scanLinePatternAndWedgeBoundary"},
    {"role": "tracked", "family": "amber", "nonColorCarrier": "doubleBoundaryAndTrackedGlyph"},
    {"role": "hunted", "family": "magentaRed", "nonColorCarrier": "triangularChevronsAndPulseCadence"},
